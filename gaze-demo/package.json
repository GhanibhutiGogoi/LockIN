    "postinstall": "node scripts/copy-wasm.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.18",
    "@tensorflow/tfjs": "4.22.0",
    "mathjs": "14.5.2",
    "ml-matrix": "6.12.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "~5.8.3",
    "vite": "^6.1.0"
  }
}
