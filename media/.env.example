# Development only: estimated captions, no generated audio. Normal UI rejects mock.
LOCKIN_MODE=mock
LOCKIN_DATA_DIR=./data
LOCKIN_CORS_ORIGINS=["http://localhost:5180","http://127.0.0.1:5180","http://localhost:5173","http://127.0.0.1:5173"]
LOCKIN_FISH_URL=http://127.0.0.1:8021
LOCKIN_ALIGNER_URL=http://127.0.0.1:8022
# Server-side only. Leave empty when the Fish server is bound to loopback.
LOCKIN_FISH_API_KEY=
# Optional content-team service. Set this so the UI only needs the media API's
# public URL. Scripts and feedback are forwarded to this private upstream.
LOCKIN_CONTENT_URL=
LOCKIN_CONTENT_API_KEY=
LOCKIN_VOICE_DEVICES=cuda:0,cuda:1,cuda:2,cuda:3
LOCKIN_REQUEST_TIMEOUT=45
LOCKIN_QUEUE_TIMEOUT=3
# These are LOCAL paths after setup/download, never remote URLs.
LOCKIN_MODEL_ROOT=./models
LOCKIN_VIDEO_PYTHON=./vendor/ltx/.venv/bin/python
LOCKIN_VIDEO_GPUS=0
LOCKIN_VIDEO_OFFLOAD=cpu
LOCKIN_VIDEO_TIMEOUT=7200
# Optional local, licensed music file. It is ducked into the narration MP3.
LOCKIN_MUSIC_FILE=

# Local studio script writer. For Claude Code select claude. For a compatible
# chat-completions gateway select api and supply its base URL, model and token.
LOCKIN_LLM_PROVIDER=codex
LOCKIN_LLM_MODEL=
LOCKIN_LLM_BASE_URL=
LOCKIN_LLM_API_KEY=
