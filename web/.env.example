# Normal defaults: real PDF study without synthetic AI or attention data.
# Mocks are permitted only through npm run dev:demo.
# The development Integrations panel can override local defaults.
# Settings → AI connection saves a browser-local override in production too.
# For one shared API URL, configure LOCKIN_CONTENT_URL on the media server.
VITE_ATTENTION_PROVIDER=off       # off | ws | local-gaze (BlazeGaze) | eyetheia
VITE_ATTENTION_WS_URL=ws://localhost:8765

VITE_CONTENT_PROVIDER=local       # local (PDF reader) | http (AI scripts / PPTX conversion)
VITE_CONTENT_URL=http://localhost:8010

VITE_MEDIA_PROVIDER=off           # off | http (real audio required)
VITE_MEDIA_URL=http://localhost:8011

VITE_ADAPTIVE_PROVIDER=local      # local (settings + statistics) | http | memory
VITE_ADAPTIVE_URL=http://localhost:8012
