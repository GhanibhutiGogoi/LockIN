# Which implementation each team's module uses: mock | http | ws
# (Dev panel — press ` in the app — can override these at runtime.)
VITE_ATTENTION_PROVIDER=mock      # mock | ws
VITE_ATTENTION_WS_URL=ws://localhost:8765

VITE_CONTENT_PROVIDER=mock        # mock | http
VITE_CONTENT_URL=http://localhost:8010

VITE_MEDIA_PROVIDER=mock          # mock | http
VITE_MEDIA_URL=http://localhost:8011

VITE_ADAPTIVE_PROVIDER=mock       # mock | http
VITE_ADAPTIVE_URL=http://localhost:8012
